  "cards": [
    {
      "dot": "cyan",
      "title": "Continuous Intake & Session Memory",
      "items": [
        "daily-briefing polls JIRA, GitHub, and ledger in parallel and deduplicates against in_herdr",
        "work-tracker injects pwd resume briefs across startup, /clear, and /compact"
      ]
    },
    {
      "dot": "violet",
      "title": "Single-Host Isolation & Herdr",
      "items": [
        "cubrid-workenv allocates & reclaims TCP ports, SysV SHM keys, sockets, and DBs per worktree",
        "Herdr enforces 8 sub-tabs and 4 worker AIs per Space while keeping orchestrator context lean"
      ]
    },
    {
      "dot": "amber",
      "title": "HITL Gates & Self-Improvement",
      "items": [
        "Tier 1 solo repos auto ff-merge; Tier 2 CUBRID/* requires human approval for Draft PR, JIRA filing, and Merge",
        "my-cubrid-workflow tracks rule-to-code drift via sync-lock.toml SHA-256 digests",
        "failure-tracker deduplicates workflow/skill/tool errors so parallel improve-failures workers fix root causes"
      ]
    }
  ]
