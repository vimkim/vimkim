  "cards": [
    {
      "dot": "slate",
      "title": "External Truth vs Durable Drafts",
      "items": [
        "External Systems (JIRA, GitHub, Discord) hold shared truth; Doc & Rule Repos version Markdown drafts and sync-lock.toml before external writes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Session Memory & Failure Ledger",
      "items": [
        "work-tracker persists per-cwd status, notes, and transition history in SQLite WAL and injects a resume brief on startup, /clear, and /compact",
        "failure-tracker deduplicates recurring workflow/skill/tool failures and coordinates lease-based parallel improve-failures repairs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Single-Host Isolation & Daemons",
      "items": [
        "cubrid-workenv assigns non-overlapping TCP ports, SysV SHM keys, sockets, and install prefixes and reclaims them on worktree delete",
        "systemd --user daemons handle slow polling and outbox delivery while keeping Herdr Space context lean"
      ]
    }
  ]
